# Public Supabase credentials (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Never expose with the NEXT_PUBLIC_ prefix.
# Used by the seed script and by checkout to write orders.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: used for absolute links in metadata and order emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
