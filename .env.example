# Public Supabase credentials (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Never expose with the NEXT_PUBLIC_ prefix.
# Used by the seed script, checkout, newsletter and the /admin panel.
SUPABASE_SERVICE_ROLE_KEY=

# Password required to enter /admin. Pick something long and unique.
ADMIN_PASSWORD=

# Optional: secret used to sign the admin session cookie.
# Defaults to ADMIN_PASSWORD when empty.
ADMIN_SESSION_SECRET=

# Optional: used for absolute links in metadata, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
